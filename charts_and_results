X = muestras_grafica[:-1]
Y = muestras_grafica[1:]

plt.figure(figsize=(8, 8))
plt.scatter(X, Y, s=0.1, c='blue', alpha=0.5)

plt.title('Prueba de Caos XY - Algoritmo con Barajado de Bits (Thomas Wang)')
plt.xlabel('Numero Actual (Coordenada X)')
plt.ylabel('Siguiente Numero (Coordenada Y)')
plt.grid(True, linestyle='--', alpha=0.5)

plt.show()

